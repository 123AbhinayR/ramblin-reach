# Copy to .env.local, NEVER commit real credentials.
# Supabase project values - consult project dashboard and @supabase/ssr current docs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Operator credentials belong in .env.seed.local; see .env.seed.example.
# AI optional, server-only; app must run without it when MOCK_AI=1.
OPENAI_API_KEY=
OPENAI_MODEL=
# Disabled in production. Protect with server-side environment checks.
DEMO_MODE=0
MOCK_AI=1
# Explicit deployment classification; NODE_ENV=production also occurs on staging builds.
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
